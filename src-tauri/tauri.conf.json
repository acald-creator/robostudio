{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "robostudio",
	"version": "0.1.0",
	"identifier": "com.acald-creator.robostudio",
	"build": {
		"beforeDevCommand": "npm run start",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist/robostudio/browser"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "robostudio",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"resizable": true,
				"maximized": true,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
