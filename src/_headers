/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# index.html must never be cached: it references the hashed bundles, so a stale
# copy pins users to an old build.
/index.html
  Cache-Control: no-cache

# Everything Angular emits with a content hash is safe to cache forever.
/media/*
  Cache-Control: public, max-age=31536000, immutable
